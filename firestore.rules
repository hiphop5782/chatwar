rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.messages == [];
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages'])
        && request.resource.data.messages is list
        && request.resource.data.messages.size() >= 1
        && request.resource.data.messages.size() <= 100
        && request.resource.data.messages[request.resource.data.messages.size() - 1].keys()
          .hasOnly(['id', 'uid', 'nickname', 'type', 'text', 'emojiId', 'createdAt'])
        && request.resource.data.messages[request.resource.data.messages.size() - 1].uid == request.auth.uid
        && request.resource.data.messages[request.resource.data.messages.size() - 1].nickname is string
        && request.resource.data.messages[request.resource.data.messages.size() - 1].nickname.size() >= 1
        && request.resource.data.messages[request.resource.data.messages.size() - 1].nickname.size() <= 20
        && (
          (
            request.resource.data.messages[request.resource.data.messages.size() - 1].type == 'text'
            && request.resource.data.messages[request.resource.data.messages.size() - 1].text is string
            && request.resource.data.messages[request.resource.data.messages.size() - 1].text.size() >= 1
            && request.resource.data.messages[request.resource.data.messages.size() - 1].text.size() <= 500
            && request.resource.data.messages[request.resource.data.messages.size() - 1].emojiId == null
          )
          ||
          (
            request.resource.data.messages[request.resource.data.messages.size() - 1].type == 'emoji'
            && request.resource.data.messages[request.resource.data.messages.size() - 1].text == ''
            && request.resource.data.messages[request.resource.data.messages.size() - 1].emojiId is int
            && request.resource.data.messages[request.resource.data.messages.size() - 1].emojiId >= 1
            && request.resource.data.messages[request.resource.data.messages.size() - 1].emojiId <= 111
          )
        );
      allow delete: if false;
    }
  }
}
